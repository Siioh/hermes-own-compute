# Cloud Compute agent image.
#
# Default base: the Hermes Agent image v0.23.0, pinned by its multi-arch manifest digest.
# A lighter base is enough for script mode (no model, only git and a POSIX shell):
#   podman build \
#     --build-arg BASE=docker.io/library/python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b \
#     -t localhost/cloud-compute-agent:0.1-lite -f images/agent/Containerfile .
#
# The image holds no secrets and no git credentials. The model key reaches a running
# sandbox only as a runtime environment variable (CC_AGENT_API_KEY). The container runs
# `sleep infinity`; the agent runner is started later with `exec`.
ARG BASE=docker.io/nousresearch/hermes-agent:v0.23.0@sha256:adb7890916de63245523492be8f68f9d2095fecbec4e2a6dab7960381f0fc002
FROM ${BASE}

USER root

RUN set -eu; \
    if ! command -v git >/dev/null 2>&1; then \
        if command -v apt-get >/dev/null 2>&1; then \
            export DEBIAN_FRONTEND=noninteractive; \
            apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
            && rm -rf /var/lib/apt/lists/*; \
        elif command -v dnf >/dev/null 2>&1; then \
            dnf install -y git-core && dnf clean all; \
        elif command -v apk >/dev/null 2>&1; then \
            apk add --no-cache git; \
        else \
            echo "no supported package manager to install git" >&2; exit 1; \
        fi; \
    fi; \
    if ! id agent >/dev/null 2>&1; then \
        if command -v useradd >/dev/null 2>&1; then \
            useradd --create-home --shell /bin/sh agent; \
        else \
            adduser -D -s /bin/sh agent; \
        fi; \
    fi; \
    mkdir -p /work; \
    chown agent:agent /work; \
    git --version

ENV HOME=/home/agent \
    HERMES_HOME=/work/.hermes \
    HERMES_WRITE_SAFE_ROOT=/work \
    GIT_TERMINAL_PROMPT=0

WORKDIR /work
USER agent

ENTRYPOINT []
CMD ["sleep", "infinity"]
